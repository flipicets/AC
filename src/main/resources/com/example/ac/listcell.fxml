<?xml version="1.0" encoding="UTF-8"?>

<!-- os import funcionam que nem no java, cada componente usado aqui embaixo precisa ser importado -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  o desenho de UMA linha da loja   [ícone] [nome / descrição / nível]  [custo]  [Comprar]
  quem carrega esse arquivo é o UpgradeCell e quem preenche os dados é o UpgradeCellController
  as duas abas (Loja e Melhorias) usam essa mesma linha

  os textos que tão aqui ("Nome do upgrade", "Label", "Nv. 0") são só de enfeite pro Scene Builder,
  no jogo a controller troca todos
-->

<!-- HBox = coloca os filhos um do lado do outro, fx:controller = a classe que controla essa linha -->
<HBox alignment="CENTER_LEFT" maxWidth="385.0" minHeight="62.0" prefWidth="385.0" spacing="8.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ac.UpgradeCellController">
   <children>
      <!-- o ícone, fica dentro de um StackPane de largura fixa pra o texto começar sempre no mesmo lugar
           mesmo se o ícone for estreito ou largo, preserveRatio = não estica -->
      <StackPane minWidth="52.0" prefWidth="52.0">
         <children>
            <ImageView fx:id="imagem" fitHeight="52.0" fitWidth="52.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </StackPane>
      <!-- VBox = empilha um embaixo do outro, aqui nome, descrição e nível -->
      <VBox alignment="CENTER_LEFT" maxWidth="165.0" minWidth="165.0" spacing="1.0">
         <children>
            <Label fx:id="nome" style="-fx-font-weight: bold;" text="Nome do upgrade" />
            <!-- wrapText = se a descrição for comprida quebra em duas linhas em vez de cortar -->
            <Label fx:id="descricao" maxWidth="165.0" style="-fx-font-size: 11;" text="Label" wrapText="true" />
            <!-- "Nv. 3", "Nv. 2/10" ou "Comprado", quem monta é o textoDoNivel() da controller -->
            <Label fx:id="nivel" style="-fx-font-size: 11;" text="Nv. 0" />
         </children>
      </VBox>
      <!-- a palavra "Custo" e o preço embaixo, o preço tem bind com o precoProperty do upgrade -->
      <VBox alignment="CENTER" minWidth="60.0" prefWidth="60.0">
         <children>
            <Label style="-fx-font-size: 11;" text="Custo" />
            <Label fx:id="preco" alignment="CENTER" style="-fx-font-weight: bold;" text="Label" />
         </children>
      </VBox>
      <!-- o botão, onAction = clicar chama o comprar() do UpgradeCellController
           a controller troca o texto pra "MÁX" e desabilita quando chega no nível máximo -->
      <Button fx:id="botaoComprar" mnemonicParsing="false" onAction="#comprar" minWidth="78.0" prefHeight="40.0" prefWidth="78.0" style="-fx-font-size: 11;" text="Comprar" />
   </children>
   <!-- padding/Insets = espacinho em cima e embaixo da linha -->
   <padding>
      <Insets bottom="2.0" top="2.0" />
   </padding>
</HBox>